# ---------------------------------------------------------------
# 游戏素材与导出数据：体积大（约 14 GB），且属于游戏版权内容
# 本仓库只托管工具链代码，以下目录一律不入库
# ---------------------------------------------------------------

# 成品图库 / 动态 CG
/CG/
/动态CG/动图/

# 动态 CG 的生成产物与第三方构建文件（可由 npm 与脚本重建）
/动态CG/查看器.html
/动态CG/_spine-canvas.min.js
/动态CG/runtime/node_modules/

# 导出文本
/主线剧情/
/其他剧情/

# 解密与解包产物
/decrypted/
/staticdata/
/catalogs/
/staging/
/data_raw/

# 索引里的图片与生成的单文件画廊（CSV/JSON 索引保留）
/CG索引/缩略图/
/CG索引/图文版/
/CG索引/*.webp
/CG索引/*.png
/CG索引/剧情CG索引.html

# ---------------------------------------------------------------
# 代码与运行时
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/

# 编辑器与系统
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# 本地临时
*.log
*.tmp
*.bak
/tmp/

# 更新检查与临时解包产物（每次版本更新重新生成）
/_update_check/

# 导出的 Spine 模型（可由 export_spine_cg.py / export_event_scene.py 重建）
/动态CG/模型/
